# /etc/conciliarh/web.env — 0640 root:conciliarh-web. Enlazado como /opt/conciliarh/current/.env (docs/DEPLOYMENT.md §6)
# NO incluye: DB_MIGRATE_*, WORKER_*, SCHEDULER_*, ACCOUNT_HMAC_KEYS (la web no los necesita)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://conciliarh.municipio.example
APP_TIMEZONE=America/Mexico_City
APP_KEY=
ACCOUNT_ENC_KEY_ID=k1
ACCOUNT_ENC_KEYS=k1:
REPORT_ENC_KEY_ID=r1
REPORT_ENC_KEYS=r1:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=conciliarh
DB_SSLMODE=prefer
DB_USERNAME=conciliarh_web
DB_PASSWORD=
SESSION_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10
MAX_UPLOAD_SIZE=26214400
STORAGE_PATH=/var/lib/conciliarh
WORKER_HEARTBEAT_TIMEOUT=120
