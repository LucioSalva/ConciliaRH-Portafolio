# /etc/conciliarh/backup.env — 0600 root:root (lo lee systemd). Rol de SÓLO LECTURA; la contraseña en PGPASSFILE.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=conciliarh
PGUSER=conciliarh_backup
# 0600 conciliarh-backup: «host:puerto:base:usuario:contraseña»
PGPASSFILE=/var/lib/conciliarh-backup/pgpass
CONCILIARH_STORAGE=/var/lib/conciliarh
BACKUP_DIR=/var/backups/conciliarh
BACKUP_RETENTION_DAYS=30
# Llave PÚBLICA de cifrado y llave de firma del respaldo, en GNUPGHOME=/var/lib/conciliarh-backup/gnupg
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_SIGNER=
# Producción: sin las dos llaves anteriores el respaldo FALLA (nunca queda un respaldo en claro sin que nadie lo note)
BACKUP_REQUIRE_ENCRYPTION=1
