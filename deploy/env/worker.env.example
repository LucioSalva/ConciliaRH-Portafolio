# /etc/conciliarh/worker.env — 0600 root:root (lo lee systemd). NO incluye REPORT_ENC_KEYS, APP_KEY ni DB_MIGRATE_*.
APP_ENV=production
ACCOUNT_ENC_KEY_ID=k1
ACCOUNT_ENC_KEYS=k1:
ACCOUNT_HMAC_KEYS=h1:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=conciliarh
DB_SSLMODE=prefer
WORKER_DB_USERNAME=conciliarh_worker
WORKER_DB_PASSWORD=
WORKER_HEARTBEAT_TIMEOUT=120
WORKER_POLL_INTERVAL=5
STORAGE_PATH=/var/lib/conciliarh
