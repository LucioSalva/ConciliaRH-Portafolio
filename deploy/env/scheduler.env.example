# /etc/conciliarh/scheduler.env — 0600 root:root (lo lee systemd). NO incluye llaves de cuentas, HMAC, APP_KEY ni DB_MIGRATE_*.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://conciliarh.municipio.example
APP_TIMEZONE=America/Mexico_City
REPORT_ENC_KEY_ID=r1
REPORT_ENC_KEYS=r1:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=conciliarh
DB_SSLMODE=prefer
SCHEDULER_DB_USERNAME=conciliarh_scheduler
SCHEDULER_DB_PASSWORD=
STORAGE_PATH=/var/lib/conciliarh
