# =====================================================================
# ConciliaRH — configuración de ejemplo (docs/DEPLOYMENT.md §6)
#
# Copie este archivo y ajuste los valores. NUNCA versione el archivo real ni guarde secretos aquí.
# Las variables de entorno del sistema (systemd EnvironmentFile, SetEnv de Apache) tienen prioridad sobre .env.
#
# Marcas:
#   [REQUERIDA]   la aplicación NO arranca sin ella (o con un valor inválido)
#   [OPCIONAL]    tiene un valor por omisión seguro
#   [PRODUCCIÓN]  valor obligatorio u obligatorio de revisar en producción
#   [DESARROLLO]  sólo desarrollo/pruebas; NO la defina en producción
#
# En producción cada servicio lee SÓLO su archivo (docs/DEPLOYMENT.md §6):
#   /etc/conciliarh/web.env        servidor web (PHP)
#   /etc/conciliarh/worker.env     worker Python
#   /etc/conciliarh/scheduler.env  scheduler (reportes programados)
#   /etc/conciliarh/cli.env        rol propietario: migraciones, GOD y rotaciones (sólo mientras se usan)
# La columna «Servicios» indica en cuál(es) debe estar cada variable.
#
# Llaves: 64 hexadecimales cada una, TODAS distintas. Generar: openssl rand -hex 32
# =====================================================================

# --- Aplicación ------------------------------------- Servicios: web, worker, scheduler, cli
# [REQUERIDA] development | testing | production
APP_ENV=production
# [PRODUCCIÓN] false. La app se niega a arrancar en producción con true.
APP_DEBUG=false
# [PRODUCCIÓN] URL pública con https://
APP_URL=https://conciliarh.municipio.example
# [OPCIONAL] zona horaria (por omisión America/Mexico_City)
APP_TIMEZONE=America/Mexico_City

# --- Secretos de la web ------------------------------- Servicios: web, cli
# [REQUERIDA] 64 hex: CSRF, bloqueo de login y firmas internas
APP_KEY=CHANGE_ME

# --- Cifrado de cuentas/CLABE (AES-256-GCM) ------------- Servicios: web, worker, cli
# [REQUERIDA] anillo "id:64hex[,id:64hex]" y la llave activa para cifrar
ACCOUNT_ENC_KEY_ID=k1
ACCOUNT_ENC_KEYS=k1:CHANGE_ME_64_HEX

# --- HMAC de cuentas (comparación sin descifrar) -------- Servicios: worker, cli (la web NO la recibe)
# [REQUERIDA en worker] anillo "id:64hex[,id:64hex]"; la llave ACTIVA la decide la BD (docs/HMAC_ROTATION.md)
ACCOUNT_HMAC_KEYS=h1:CHANGE_ME_64_HEX
# [OPCIONAL] compatibilidad: llave única histórica (= h1). Use ACCOUNT_HMAC_KEYS.
ACCOUNT_HMAC_KEY=

# --- Cifrado de reportes generados ---------------------- Servicios: web (descarga), scheduler (generación), cli (rotación)
# [REQUERIDA] anillo propio, DISTINTO de las llaves de cuentas, HMAC y APP_KEY (la app lo verifica)
REPORT_ENC_KEY_ID=r1
REPORT_ENC_KEYS=r1:CHANGE_ME_64_HEX

# --- Base de datos ------------------------------------ Servicios: todos
# [REQUERIDA]
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=conciliarh
# [PRODUCCIÓN] require | verify-full si la BD está en otro host
DB_SSLMODE=prefer

# Rol de la web (conciliarh_web) ----------------------- Servicios: web
# [REQUERIDA]
DB_USERNAME=conciliarh_web
DB_PASSWORD=CHANGE_ME

# Rol del worker (conciliarh_worker) -------------------- Servicios: worker
# [REQUERIDA en worker]
WORKER_DB_USERNAME=conciliarh_worker
WORKER_DB_PASSWORD=CHANGE_ME
# [OPCIONAL] segundos sin latido para considerar un trabajo abandonado (mín. 30)
WORKER_HEARTBEAT_TIMEOUT=120
# [OPCIONAL] segundos entre consultas a la cola (1–60)
WORKER_POLL_INTERVAL=5

# Rol del scheduler (conciliarh_scheduler) -------------- Servicios: scheduler
# [REQUERIDA en scheduler]
SCHEDULER_DB_USERNAME=conciliarh_scheduler
SCHEDULER_DB_PASSWORD=CHANGE_ME

# Rol propietario del esquema (conciliarh_owner) -------- Servicios: cli (NUNCA en web.env)
# [REQUERIDA sólo para] bin/migrate.php, bin/create-god.php, bin/rotate-*.php, bin/preflight.php --db-owner
DB_MIGRATE_USERNAME=conciliarh_owner
DB_MIGRATE_PASSWORD=CHANGE_ME

# --- Sesión --------------------------------------------- Servicios: web
# [PRODUCCIÓN] true obligatorio bajo HTTPS (la app lo exige si APP_URL usa https://)
SESSION_SECURE=true
# [OPCIONAL]
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=10

# --- Archivos ------------------------------------------- Servicios: web, worker, scheduler
# [OPCIONAL] bytes por archivo cargado (25 MiB). Debe ser < upload_max_filesize < post_max_size < LimitRequestBody
MAX_UPLOAD_SIZE=26214400
# [PRODUCCIÓN] ruta absoluta fuera del web root (vacío = <instalación>/storage)
STORAGE_PATH=

# --- Worker Python --------------------------------------- Servicios: worker
# [OPCIONAL] raíz de la instalación si el worker no corre desde <instalación>/python
CONCILIARH_BASE_PATH=

# --- Respaldo (scripts/backup.sh y scripts/restore.sh) --- Servicios: respaldo (su propio entorno, no web.env)
# Conexión con variables estándar de libpq: PGHOST PGPORT PGDATABASE PGUSER y PGPASSWORD o ~/.pgpass (nunca aquí).
# [REQUERIDA en respaldo]
CONCILIARH_STORAGE=
BACKUP_DIR=
# [PRODUCCIÓN] cifra en flujo con esta llave PÚBLICA gpg y firma con esta llave PRIVADA
BACKUP_GPG_RECIPIENT=
BACKUP_GPG_SIGNER=
# [OPCIONAL] días de retención dentro de BACKUP_DIR
BACKUP_RETENTION_DAYS=
# [PRODUCCIÓN] 1 = restore.sh exige la firma SHA256SUMS.sig válida (por omisión 0; use 1 en producción)
RESTORE_REQUIRE_SIGNATURE=1

# --- Desarrollo ------------------------------------------ [DESARROLLO] no definir en producción
# DB_TEST_DATABASE=conciliarh_test
