{
    "name": "luciosalva/conciliarh",
    "description": "ConciliaRH — Sistema Integral de Conciliación de Nómina y Pagos",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-bcmath": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1",
        "openspout/openspout": "^4.28",
        "phpoffice/phpspreadsheet": "^5.9"
    },
    "require-dev": {
        "league/commonmark": "^2.7",
        "phpunit/phpunit": "^12.3"
    },
    "autoload": {
        "psr-4": {
            "ConciliaRH\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ConciliaRH\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
